# Copiar a .env (nunca commitear/publicar .env con valores reales).

# Puerto interno en el que escucha Node.js (solo 127.0.0.1, ver
# docs/DEPLOYMENT_UBIQUITOUS.md para el puerto realmente asignado).
PORT=3000

# Conexión a PostgreSQL (clúster propio en $HOME, ver deploy/pg_cluster_init.sh).
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=library
PGUSER=library_app
PGPASSWORD=changeme

# Secreto para firmar la cookie de sesión (generar uno propio, largo y aleatorio).
SESSION_SECRET=changeme

# Límite de tamaño de imagen subida, en bytes.
MAX_UPLOAD_BYTES=5242880

NODE_ENV=production
# En true solo si Apache termina TLS y reenvía por HTTPS hasta el proxy.
COOKIE_SECURE=false
