<%- include('../partials/header', { title }) %>
<section>
  <h1>Panel de administración</h1>
  <div class="stat-grid">
    <div class="stat-card"><strong><%= totalBooks %></strong><span>Libros</span></div>
    <div class="stat-card"><strong><%= totalUsers %></strong><span>Usuarios</span></div>
  </div>

  <nav class="admin-nav">
    <a href="<%= basePath %>/library/admin/books">Libros</a>
    <a href="<%= basePath %>/library/admin/catalogs/authors">Autores</a>
    <a href="<%= basePath %>/library/admin/catalogs/genres">Géneros</a>
    <a href="<%= basePath %>/library/admin/catalogs/formats">Formatos</a>
    <a href="<%= basePath %>/library/admin/catalogs/categories">Categorías</a>
    <a href="<%= basePath %>/library/admin/concepts">Conceptos</a>
  </nav>

  <% if (lowStock.length) { %>
    <h2>Stock bajo (&lt; 5 unidades)</h2>
    <table class="data-table">
      <thead><tr><th>ISBN</th><th>Título</th><th>Stock</th></tr></thead>
      <tbody>
        <% lowStock.forEach(function (b) { %>
          <tr><td><%= b.isbn %></td><td><a href="<%= basePath %>/library/admin/books/<%= b.book_id %>/edit"><%= b.title %></a></td><td><%= b.stock %></td></tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include('../partials/footer') %>
