<%- include('../../partials/header', { title }) %>
<section>
  <a class="back-link" href="<%= basePath %>/library/admin">← Volver al panel</a>
  <h1>Conceptos</h1>
  <p class="hint">Catálogo de conceptos reutilizables. La definición de cada concepto se registra por libro desde la pantalla de edición de un libro (puede variar entre libros).</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <ul class="chip-list">
    <% items.forEach(function (c) { %><li class="chip"><%= c.name %></li><% }) %>
  </ul>

  <h2>Agregar concepto</h2>
  <form action="<%= basePath %>/library/admin/concepts" method="post" class="form-stack">
    <label>Nombre
      <input type="text" name="name" required>
    </label>
    <button type="submit" class="button button-primary">Agregar</button>
  </form>
</section>
<%- include('../../partials/footer') %>
